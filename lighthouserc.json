{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "/index.html",
        "/pixworm.html",
        "/pixworm/prague.html",
        "/blogs.html",
        "/blogs/pointers.html",
        "/projects/stack.html",
        "/projects/tracking.html",
        "/projects/route-planning.html",
        "/projects/watchdog.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.8
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "errors-in-console": "off",
        "total-byte-weight": [
          "warn",
          {
            "maxNumericValue": 2000000
          }
        ],
        "resource-summary:script:size": [
          "error",
          {
            "maxNumericValue": 250000
          }
        ],
        "resource-summary:stylesheet:size": [
          "error",
          {
            "maxNumericValue": 120000
          }
        ],
        "unused-javascript": "off"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
