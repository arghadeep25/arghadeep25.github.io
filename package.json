{
  "name": "arghadeep25-github-io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "postbuild": "cp -r assets/js dist/assets/js && cp -r assets/vendor dist/assets/vendor",
    "format": "prettier --write \"src/**/*.{js,css,html}\" \"*.{js,json,md}\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{js,css,html}\" \"*.{js,json,md}\" \"docs/**/*.md\""
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "vite": "^8.3.4"
  }
}
