{
  "name": "arghadeep25-github-io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{js,css,html}\" \"*.{js,json,md}\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{js,css,html}\" \"*.{js,json,md}\" \"docs/**/*.md\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
